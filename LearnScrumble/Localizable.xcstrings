    "No struggle words yet — keep practicing!" : {
      "comment" : "Shown when the user starts a review but has no struggle words yet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد كلمات صعبة بعد — واصل التدرّب!"
