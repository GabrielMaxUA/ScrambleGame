        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серверлеріміз қазір бос емес. Сәлден кейін қайталап көріңіз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಮ್ಮ ಸರ್ವರ್‌ಗಳು ಈಗ ಕಾರ್ಯನಿರತವಾಗಿವೆ. ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 서버가 혼잡합니다. 잠시 후 다시 시도하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mūsų serveriai šiuo metu užimti. Bandykite dar kartą po akimirkos."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഞങ്ങളുടെ സെർവറുകൾ ഇപ്പോൾ തിരക്കിലാണ്. അൽപ്പസമയത്തിന് ശേഷം വീണ്ടും ശ്രമിക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आमचे सर्व्हर सध्या व्यस्त आहेत. थोड्या वेळाने पुन्हा प्रयत्न करा."
