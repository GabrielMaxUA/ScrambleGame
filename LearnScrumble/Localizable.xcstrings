        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үйреніп жатқан тіліңіздегі барлық жауаптарыңыз жойылады. Бұл әрекетті болдырмау мүмкін емес."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಕಲಿಯುತ್ತಿರುವ ಭಾಷೆಯಲ್ಲಿನ ನಿಮ್ಮ ಎಲ್ಲಾ ಉತ್ತರಗಳನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학습 중인 언어로 입력한 모든 답변이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi jūsų atsakymai kalba, kurios mokotės, bus ištrinti. Šio veiksmo anuliuoti negalima."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ പഠിക്കുന്ന ഭാഷയിലെ നിങ്ങളുടെ എല്ലാ ഉത്തരങ്ങളും ഇല്ലാതാക്കും. ഇത് പഴയപടിയാക്കാനാവില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही शिकत असलेल्या भाषेतील तुमची सर्व उत्तरे हटवली जातील. हे पूर्ववत करता येणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua jawapan anda dalam bahasa yang sedang anda pelajari akan dipadamkan. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle svarene dine på språket du lærer, blir slettet. Dette kan ikke angres."
