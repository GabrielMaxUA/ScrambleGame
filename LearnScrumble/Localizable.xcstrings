    "Our servers are busy right now. Please try again in a moment." : {
      "comment" : "Error shown when the server is rate-limited or temporarily unavailable.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خوادمنا مشغولة الآن. حاول مرة أخرى بعد قليل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърите ни са заети в момента. Опитайте отново след малко."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমাদের সার্ভার এখন ব্যস্ত। একটু পরে আবার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els nostres servidors estan ocupats ara mateix. Torna-ho a provar d’aquí a un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naše servery jsou teď přetížené. Zkuste to za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vores servere har travlt lige nu. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsere Server sind gerade ausgelastet. Bitte versuche es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι διακομιστές μας είναι απασχολημένοι αυτή τη στιγμή. Δοκίμασε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our servers are busy right now. Please try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestros servidores están ocupados en este momento. Inténtalo de nuevo en un momento."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gure zerbitzariak lanpetuta daude orain. Saiatu berriro une batean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرورهای ما الان شلوغ هستند. کمی بعد دوباره امتحان کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimemme ovat nyt ruuhkautuneet. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
