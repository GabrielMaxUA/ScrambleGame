          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nosos servidores están ocupados agora mesmo. Téntao de novo nun momento."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અમારા સર્વર હાલમાં વ્યસ્ત છે. થોડી વારમાં ફરી પ્રયાસ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרתים שלנו עמוסים כרגע. נסו שוב בעוד רגע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमारे सर्वर अभी व्यस्त हैं। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naši poslužitelji trenutačno su zauzeti. Pokušajte ponovno za trenutak."
          }
        },
        "hu" : {
          "stringUnit" : {
