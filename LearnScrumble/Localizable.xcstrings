        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଶିଖୁଥିବା ଭାଷାରେ ଦେଇଥିବା ଆପଣଙ୍କ ସମସ୍ତ ଉତ୍ତର ଡିଲିଟ୍ ହୋଇଯିବ। ଏହାକୁ ପୂର୍ବାବସ୍ଥାକୁ ଫେରାଇହେବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਜੋ ਭਾਸ਼ਾ ਸਿੱਖ ਰਹੇ ਹੋ, ਉਸ ਵਿੱਚ ਦਿੱਤੇ ਤੁਹਾਡੇ ਸਾਰੇ ਜਵਾਬ ਮਿਟਾ ਦਿੱਤੇ ਜਾਣਗੇ। ਇਸਨੂੰ ਵਾਪਸ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
