        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podes descargar máis voces en Axustes › Accesibilidade › Contido falado › Voces do iPhone."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneના સેટિંગ્સ › ઍક્સેસિબિલિટી › બોલાયેલી સામગ્રી › અવાજોમાંથી વધુ અવાજો ડાઉનલોડ કરી શકાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן להוריד קולות נוספים ב-iPhone בהגדרות › נגישות › תוכן מוקרא › קולות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone की सेटिंग्स › ऐक्सेसिबिलिटी › बोली गई सामग्री › आवाज़ें में और आवाज़ें डाउनलोड की जा सकती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više glasova možete preuzeti u Postavke › Pristupačnost › Izgovoreni sadržaj › Glasovi na iPhoneu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "További hangokat az iPhone Beállítások › Kisegítő lehetőségek › Felolvasott tartalom › Hangok menüjében tölthetsz le."
