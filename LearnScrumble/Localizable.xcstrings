        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो भाषा सीख रहे हैं, उसमें दिए गए आपके सभी जवाब हटा दिए जाएँगे। इसे पहले जैसा नहीं किया जा सकता।"
