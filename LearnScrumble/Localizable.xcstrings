        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी इस पेशे और भाषा के लिए नए शब्द नहीं मिले। बाद में कोशिश करें या कोई दूसरा पेशा चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenutačno nismo pronašli nove riječi za ovo zanimanje i jezik. Pokušajte kasnije ili odaberite drugo zanimanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most nem találtunk új szavakat ehhez a foglalkozáshoz és nyelvhez. Próbáld később, vagy válassz másik foglalkozást."
