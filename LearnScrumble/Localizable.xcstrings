        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो भी भाषा सीखते हैं, उसकी प्रगति अलग से सहेजी जाती है। भाषा बदलने पर आपकी पुरानी प्रगति बनी रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napredak se sprema zasebno za svaki jezik koji učite. Kad promijenite jezik, prethodni napredak ostaje sačuvan."
