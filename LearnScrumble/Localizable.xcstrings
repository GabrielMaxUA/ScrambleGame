        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंले सिकिरहनुभएको भाषामा दिएका तपाईंका सबै उत्तरहरू मेटिनेछन्। यसलाई पूर्ववत् गर्न सकिँदैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al je antwoorden in de taal die je leert, worden verwijderd. Dit kan niet ongedaan worden gemaakt."
