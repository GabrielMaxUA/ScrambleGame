          "stringUnit" : {
            "state" : "translated",
            "value" : "現在サーバーが混み合っています。少し待ってからもう一度お試しください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серверлеріміз қазір бос емес. Сәлден кейін қайталап көріңіз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಮ್ಮ ಸರ್ವರ್‌ಗಳು ಈಗ ಕಾರ್ಯನಿರತವಾಗಿವೆ. ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 서버가 혼잡합니다. 잠시 후 다시 시도하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mūsų serveriai šiuo metu užimti. Bandykite dar kartą po akimirkos."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഞങ്ങളുടെ സെർവറുകൾ ഇപ്പോൾ തിരക്കിലാണ്. അൽപ്പസമയത്തിന് ശേഷം വീണ്ടും ശ്രമിക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आमचे सर्व्हर सध्या व्यस्त आहेत. थोड्या वेळाने पुन्हा प्रयत्न करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelayan kami sibuk sekarang. Cuba lagi sebentar lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverne våre er opptatt akkurat nå. Prøv igjen om litt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाम्रा सर्भरहरू अहिले व्यस्त छन्। केही बेरपछि फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onze servers zijn nu druk. Probeer het zo meteen opnieuw."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆମ ସର୍ଭର ଏବେ ବ୍ୟସ୍ତ ଅଛି। କିଛି ସମୟ ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਾਡੇ ਸਰਵਰ ਇਸ ਵੇਲੇ ਰੁੱਝੇ ਹੋਏ ਹਨ। ਥੋੜ੍ਹੀ ਦੇਰ ਬਾਅਦ ਫਿਰ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasze serwery są teraz zajęte. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nossos servidores estão ocupados agora. Tente de novo em instantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nossos servidores estão ocupados neste momento. Tente novamente dentro de instantes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverele noastre sunt ocupate acum. Încearcă din nou peste câteva momente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наши серверы сейчас перегружены. Попробуйте ещё раз чуть позже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naše servery sú teraz vyťažené. Skúste to o chvíľu znova."
