    "Progress is saved separately for each language you learn. Switching keeps your old progress." : {
      "comment" : "A description of the user's progress in a language.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ التقدّم بشكل منفصل لكل لغة تتعلّمها. عند التبديل يبقى تقدّمك السابق محفوظًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напредъкът се запазва отделно за всеки език, който учите. При смяна старият ви напредък се запазва."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যে প্রতিটি ভাষা শেখেন, তার অগ্রগতি আলাদাভাবে সংরক্ষিত হয়। ভাষা বদলালেও আগের অগ্রগতি থেকে যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progrés es desa per separat per a cada llengua que aprens. Si canvies, conserves el progrés anterior."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrok se ukládá zvlášť pro každý jazyk, který se učíte. Při přepnutí váš dosavadní pokrok zůstane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremgangen gemmes separat for hvert sprog, du lærer. Når du skifter, beholder du din tidligere fremgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fortschritt wird für jede Sprache, die du lernst, separat gespeichert. Beim Wechseln bleibt dein bisheriger Fortschritt erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόοδος αποθηκεύεται ξεχωριστά για κάθε γλώσσα που μαθαίνεις. Αν αλλάξεις, η προηγούμενη πρόοδός σου διατηρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress is saved separately for each language you learn. Switching keeps your old progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso se guarda por separado para cada idioma que aprendes. Si cambias, conservas tu progreso anterior."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikasten duzun hizkuntza bakoitzeko aurrerapena bereiz gordetzen da. Aldatzean, lehengo aurrerapena mantentzen duzu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیشرفت برای هر زبانی که یاد می‌گیرید جداگانه ذخیره می‌شود. با تغییر زبان، پیشرفت قبلی‌تان حفظ می‌شود."
