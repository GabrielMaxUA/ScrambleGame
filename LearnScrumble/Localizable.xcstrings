    "More voices can be downloaded in the iPhone's Settings › Accessibility › Spoken Content › Voices." : {
      "comment" : "A description of the available voices.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تنزيل المزيد من الأصوات من الإعدادات في iPhone › تسهيلات الاستخدام › المحتوى المنطوق › الأصوات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Още гласове могат да бъдат изтеглени от Настройки › Достъпност › Изговорено съдържание › Гласове на iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-এর সেটিংস › অ্যাক্সেসিবিলিটি › কথিত কন্টেন্ট › কণ্ঠস্বর থেকে আরও কণ্ঠস্বর ডাউনলোড করা যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pots baixar més veus a Configuració › Accessibilitat › Contingut parlat › Veus de l’iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Další hlasy si můžete stáhnout v Nastavení › Zpřístupnění › Mluvený obsah › Hlasy na iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere stemmer kan hentes i Indstillinger › Tilgængelighed › Oplæst indhold › Stemmer på iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Stimmen kannst du auf dem iPhone unter Einstellungen › Bedienungshilfen › Gesprochene Inhalte › Stimmen laden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείς να κατεβάσεις περισσότερες φωνές από Ρυθμίσεις › Προσβασιμότητα › Εκφωνούμενο περιεχόμενο › Φωνές στο iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More voices can be downloaded in the iPhone's Settings › Accessibility › Spoken Content › Voices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes descargar más voces en Ajustes › Accesibilidad › Contenido leído › Voces del iPhone."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahots gehiago deskarga ditzakezu iPhone-ko Ezarpenak › Erabilerraztasuna › Ahozko edukia › Ahotsak atalean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صداهای بیشتری را می‌توانید از تنظیمات › دسترس‌پذیری › محتوای گفتاری › صداها در iPhone بارگیری کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ääniä voi ladata iPhonen kohdasta Asetukset › Käyttöapu › Puhuttu sisältö › Äänet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’autres voix peuvent être téléchargées dans Réglages › Accessibilité › Contenu énoncé › Voix sur l’iPhone."
