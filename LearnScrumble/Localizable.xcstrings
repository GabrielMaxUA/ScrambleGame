          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички ваши отговори на езика, който учите, ще бъдат изтрити. Това не може да бъде отменено."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যে ভাষা শিখছেন, তাতে দেওয়া আপনার সব উত্তর মুছে ফেলা হবে। এটি আর ফেরানো যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’esborraran totes les teves respostes en la llengua que estàs aprenent. Aquesta acció no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny vaše odpovědi v jazyce, který se učíte, budou smazány. Tuto akci nelze vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle dine svar på det sprog, du lærer, bliver slettet. Det kan ikke fortrydes."
