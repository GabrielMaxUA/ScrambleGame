        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆମ ସର୍ଭର ଏବେ ବ୍ୟସ୍ତ ଅଛି। କିଛି ସମୟ ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
