        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι απαντήσεις σου στη γλώσσα που μαθαίνεις θα διαγραφούν. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your answers in the language you are learning will be deleted. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas tus respuestas en el idioma que estás aprendiendo. Esta acción no se puede deshacer."
