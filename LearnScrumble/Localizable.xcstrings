        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শব্দ ও ছবি AI দিয়ে তৈরি, তাই ভুল থাকতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paraules i les imatges es generen amb IA i poden contenir errors."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slova a obrázky generuje AI a mohou obsahovat chyby."
