        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाम्रा सर्भरहरू अहिले व्यस्त छन्। केही बेरपछि फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
