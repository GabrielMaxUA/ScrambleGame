        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಕಲಿಯುವ ಪ್ರತಿಯೊಂದು ಭಾಷೆಗೆ ಪ್ರಗತಿಯನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಉಳಿಸಲಾಗುತ್ತದೆ. ಭಾಷೆ ಬದಲಾಯಿಸಿದರೂ ನಿಮ್ಮ ಹಳೆಯ ಪ್ರಗತಿ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 상황은 학습하는 언어별로 따로 저장됩니다. 언어를 바꿔도 이전 진행 상황은 유지됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pažanga saugoma atskirai kiekvienai kalbai, kurios mokotės. Pakeitus kalbą ankstesnė pažanga išlieka."
