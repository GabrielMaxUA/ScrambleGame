        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনও কোনো কঠিন শব্দ নেই — অনুশীলন চালিয়ে যান!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
