    "Words and images are generated by AI and may contain mistakes." : {
      "comment" : "A disclaimer that the words and images generated by the app are generated by AI and may contain mistakes.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكلمات والصور مُنشأة بالذكاء الاصطناعي وقد تحتوي على أخطاء."
