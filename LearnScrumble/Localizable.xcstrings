    "Build the vocabulary.\nGain the confidence.\nUnlock new opportunities." : {
      "comment" : "A description of the features of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابنِ مفرداتك.\nاكتسب الثقة.\nافتح أبوابًا لفرص جديدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изградете речника си.\nПридобийте увереност.\nОтключете нови възможности."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শব্দভান্ডার গড়ে তুলুন।\nআত্মবিশ্বাস অর্জন করুন।\nনতুন সুযোগের দরজা খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construeix el vocabulari.\nGuanya confiança.\nObre’t a noves oportunitats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budujte slovní zásobu.\nZískejte jistotu.\nOtevřete si nové příležitosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opbyg ordforrådet.\nFå selvtilliden.\nÅbn for nye muligheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baue deinen Wortschatz auf.\nGewinne Selbstvertrauen.\nEröffne dir neue Chancen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χτίσε το λεξιλόγιό σου.\nΑπόκτησε αυτοπεποίθηση.\nΆνοιξε νέες ευκαιρίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build the vocabulary.\nGain the confidence.\nUnlock new opportunities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construye tu vocabulario.\nGana confianza.\nAbre nuevas oportunidades."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eraiki hiztegia.\nIrabazi konfiantza.\nIreki aukera berriak."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واژگانتان را بسازید.\nاعتمادبه‌نفس پیدا کنید.\nفرصت‌های تازه را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasvata sanavarastoa.\nSaavuta itsevarmuus.\nAvaa uusia mahdollisuuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construisez votre vocabulaire.\nGagnez en confiance.\nOuvrez-vous de nouvelles opportunités."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Constrúe o teu vocabulario.\nGaña confianza.\nAbre novas oportunidades."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શબ્દભંડોળ બનાવો.\nઆત્મવિશ્વાસ મેળવો.\nનવી તકો ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בנו אוצר מילים.\nקבלו ביטחון.\nפתחו הזדמנויות חדשות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दावली बनाएँ।\nआत्मविश्वास पाएँ।\nनए अवसरों के द्वार खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izgradite vokabular.\nSteknite samopouzdanje.\nOtvorite nove prilike."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Építsd a szókincsed.\nSzerezz magabiztosságot.\nNyiss új lehetőségek felé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bangun kosakatamu.\nRaih kepercayaan diri.\nBuka peluang baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruisci il tuo vocabolario.\nAcquista sicurezza.\nApriti a nuove opportunità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語彙を身につける。\n自信をつける。\n新しいチャンスを開く。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сөздік қорыңызды молайтыңыз.\nСенімділікке ие болыңыз.\nЖаңа мүмкіндіктер ашыңыз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಶಬ್ದಸಂಪತ್ತನ್ನು ಬೆಳೆಸಿ.\nಆತ್ಮವಿಶ್ವಾಸ ಗಳಿಸಿ.\nಹೊಸ ಅವಕಾಶಗಳನ್ನು ತೆರೆಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어휘를 쌓으세요.\n자신감을 얻으세요.\n새로운 기회를 여세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plėskite žodyną.\nĮgykite pasitikėjimo.\nAtverkite naujas galimybes."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പദസമ്പത്ത് വളർത്തൂ.\nആത്മവിശ്വാസം നേടൂ.\nപുതിയ അവസരങ്ങൾ തുറക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दसंग्रह वाढवा.\nआत्मविश्वास मिळवा.\nनवीन संधी खुल्या करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bina perbendaharaan kata.\nRaih keyakinan.\nBuka peluang baharu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygg ordforrådet.\nFå selvtilliten.\nÅpne for nye muligheter."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दभण्डार बनाउनुहोस्।\nआत्मविश्वास बढाउनुहोस्।\nनयाँ अवसरहरू खोल्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouw je woordenschat op.\nKrijg zelfvertrouwen.\nOpen nieuwe kansen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶବ୍ଦଭଣ୍ଡାର ଗଢ଼ନ୍ତୁ।\nଆତ୍ମବିଶ୍ୱାସ ହାସଲ କରନ୍ତୁ।\nନୂଆ ସୁଯୋଗ ଖୋଲନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ਬਦਾਵਲੀ ਬਣਾਓ।\nਆਤਮਵਿਸ਼ਵਾਸ ਹਾਸਲ ਕਰੋ।\nਨਵੇਂ ਮੌਕਿਆਂ ਦੇ ਦਰਵਾਜ਼ੇ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buduj słownictwo.\nZyskaj pewność siebie.\nOtwórz się na nowe możliwości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construa seu vocabulário.\nGanhe confiança.\nAbra novas oportunidades."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construa o seu vocabulário.\nGanhe confiança.\nAbra novas oportunidades."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construiește-ți vocabularul.\nCâștigă încredere.\nDeschide-ți noi oportunități."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширяйте словарный запас.\nОбретайте уверенность.\nОткрывайте новые возможности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budujte slovnú zásobu.\nZískajte istotu.\nOtvorte si nové príležitosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradite besedišče.\nPridobite samozavest.\nOdprite si nove priložnosti."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndërto fjalorin.\nFito vetëbesim.\nHap mundësi të reja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygg ordförrådet.\nFå självförtroendet.\nÖppna nya möjligheter."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சொல்வளத்தை வளர்த்துக்கொள்ளுங்கள்.\nதன்னம்பிக்கையைப் பெறுங்கள்.\nபுதிய வாய்ப்புகளைத் திறவுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పదసంపదను పెంచుకోండి.\nఆత్మవిశ్వాసం పొందండి.\nకొత్త అవకాశాలను అందుకోండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างคลังคำศัพท์\nเพิ่มความมั่นใจ\nเปิดโอกาสใหม่ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelime dağarcığını geliştir.\nÖzgüven kazan.\nYeni fırsatların kapısını aç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розширюйте словниковий запас.\nЗдобувайте впевненість.\nВідкривайте нові можливості."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xây dựng vốn từ.\nThêm tự tin.\nMở ra cơ hội mới."
          }
        },
        "wuu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "积累词汇。\n收获自信。\n开启新机遇。"
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "累積詞彙。\n建立自信。\n開啟新機會。"
          }
        },
