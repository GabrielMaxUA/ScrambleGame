    "We couldn't find new words for this profession and language right now. Try again later or pick a different profession." : {
      "comment" : "Error shown when no new words are available for the chosen profession and language.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم نجد كلمات جديدة لهذه المهنة واللغة حاليًا. حاول لاحقًا أو اختر مهنة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В момента не намираме нови думи за тази професия и език. Опитайте по-късно или изберете друга професия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পেশা ও ভাষার জন্য এখন নতুন শব্দ পাওয়া যায়নি। পরে চেষ্টা করুন বা অন্য পেশা বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara mateix no hem trobat paraules noves per a aquesta professió i llengua. Torna-ho a provar més tard o tria una altra professió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro tuto profesi a jazyk teď nemáme nová slova. Zkuste to později nebo vyberte jinou profesi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke finde nye ord til dette erhverv og sprog lige nu. Prøv igen senere, eller vælg et andet erhverv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Beruf und diese Sprache haben wir gerade keine neuen Wörter gefunden. Versuche es später erneut oder wähle einen anderen Beruf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρήκαμε νέες λέξεις για αυτό το επάγγελμα και τη γλώσσα αυτή τη στιγμή. Δοκίμασε αργότερα ή διάλεξε άλλο επάγγελμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find new words for this profession and language right now. Try again later or pick a different profession."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos palabras nuevas para esta profesión e idioma por ahora. Inténtalo más tarde o elige otra profesión."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez dugu hitz berririk aurkitu lanbide eta hizkuntza honetarako oraingoz. Saiatu geroago edo aukeratu beste lanbide bat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعلاً کلمهٔ جدیدی برای این شغل و زبان پیدا نکردیم. بعداً امتحان کنید یا شغل دیگری انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emme löytäneet nyt uusia sanoja tälle ammatille ja kielelle. Yritä myöhemmin tai valitse toinen ammatti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun nouveau mot trouvé pour ce métier et cette langue pour le moment. Réessayez plus tard ou choisissez un autre métier."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora mesmo non atopamos palabras novas para esta profesión e lingua. Téntao máis tarde ou escolle outra profesión."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હાલમાં આ વ્યવસાય અને ભાષા માટે નવા શબ્દો મળ્યા નથી. પછી પ્રયાસ કરો અથવા બીજો વ્યવસાય પસંદ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא מצאנו כרגע מילים חדשות למקצוע ולשפה האלה. נסו שוב מאוחר יותר או בחרו מקצוע אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी इस पेशे और भाषा के लिए नए शब्द नहीं मिले। बाद में कोशिश करें या कोई दूसरा पेशा चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenutačno nismo pronašli nove riječi za ovo zanimanje i jezik. Pokušajte kasnije ili odaberite drugo zanimanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most nem találtunk új szavakat ehhez a foglalkozáshoz és nyelvhez. Próbáld később, vagy válassz másik foglalkozást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami belum menemukan kata baru untuk profesi dan bahasa ini. Coba lagi nanti atau pilih profesi lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non troviamo nuove parole per questa professione e lingua. Riprova più tardi o scegli un’altra professione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、この職業と言語の新しい単語が見つかりません。後でもう一度試すか、別の職業を選んでください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қазір бұл мамандық пен тіл үшін жаңа сөздер табылмады. Кейінірек көріңіз немесе басқа мамандық таңдаңыз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ವೃತ್ತಿ ಮತ್ತು ಭಾಷೆಗೆ ಈಗ ಹೊಸ ಪದಗಳು ಸಿಗಲಿಲ್ಲ. ನಂತರ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ಬೇರೆ ವೃತ್ತಿಯನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 이 직업과 언어에 대한 새 단어를 찾을 수 없습니다. 나중에 다시 시도하거나 다른 직업을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šiuo metu neradome naujų žodžių šiai profesijai ir kalbai. Bandykite vėliau arba pasirinkite kitą profesiją."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ തൊഴിലിനും ഭാഷയ്ക്കും ഇപ്പോൾ പുതിയ വാക്കുകൾ കണ്ടെത്താനായില്ല. പിന്നീട് ശ്രമിക്കൂ അല്ലെങ്കിൽ മറ്റൊരു തൊഴിൽ തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सध्या या व्यवसायासाठी आणि भाषेसाठी नवीन शब्द सापडले नाहीत. नंतर प्रयत्न करा किंवा दुसरा व्यवसाय निवडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak menemui perkataan baharu untuk profesion dan bahasa ini sekarang. Cuba lagi nanti atau pilih profesion lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fant ingen nye ord for dette yrket og språket akkurat nå. Prøv igjen senere, eller velg et annet yrke."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अहिले यो पेसा र भाषाका लागि नयाँ शब्द भेटिएनन्। पछि प्रयास गर्नुहोस् वा अर्को पेसा छान्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden nu geen nieuwe woorden vinden voor dit beroep en deze taal. Probeer het later opnieuw of kies een ander beroep."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ବୃତ୍ତି ଓ ଭାଷା ପାଇଁ ଏବେ ନୂଆ ଶବ୍ଦ ମିଳିଲା ନାହିଁ। ପରେ ଚେଷ୍ଟା କରନ୍ତୁ କିମ୍ବା ଅନ୍ୟ ବୃତ୍ତି ବାଛନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਵੇਲੇ ਇਸ ਕਿੱਤੇ ਅਤੇ ਭਾਸ਼ਾ ਲਈ ਨਵੇਂ ਸ਼ਬਦ ਨਹੀਂ ਮਿਲੇ। ਬਾਅਦ ਵਿੱਚ ਕੋਸ਼ਿਸ਼ ਕਰੋ ਜਾਂ ਕੋਈ ਹੋਰ ਕਿੱਤਾ ਚੁਣੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleźliśmy teraz nowych słów dla tego zawodu i języka. Spróbuj później lub wybierz inny zawód."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não encontramos palavras novas para esta profissão e idioma agora. Tente mais tarde ou escolha outra profissão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não encontrámos palavras novas para esta profissão e língua neste momento. Tente mais tarde ou escolha outra profissão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu am găsit acum cuvinte noi pentru această profesie și limbă. Încearcă mai târziu sau alege altă profesie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас не удалось найти новые слова для этой профессии и языка. Попробуйте позже или выберите другую профессию."
