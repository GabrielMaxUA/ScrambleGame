    "All your answers in the language you are learning will be deleted. This can't be undone." : {
      "comment" : "A message that appears when the user confirms that they want to reset their progress.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
